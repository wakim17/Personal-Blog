---
layout: base.njk
title: About Me
---

<div class="homepage-container container">
  <section class="about-section" style="margin-bottom: var(--spacing-xl); padding-bottom: var(--spacing-xl);">
    <h1 style="margin-bottom: var(--spacing-md); font-size: 2rem;">Cultivating Thoughts</h1>
    <p style="font-size: 1.15rem; max-width: 65ch; opacity: 0.9;">Welcome to my personal blog. This is a place where I cultivate my thoughts, essays, and notes across various topics ranging from Theology & Religion to Science and Philosophy.</p>
  </section>

  {% set seedlings = 0 %}
  {% set buddings = 0 %}
  {% set evergreens = 0 %}
  {% for post in collections.articles %}
    {% if post.data.growth_stage == 'Seedling' %}
      {% set seedlings = seedlings + 1 %}
    {% elif post.data.growth_stage == 'Budding' %}
      {% set buddings = buddings + 1 %}
    {% elif post.data.growth_stage == 'Evergreen' %}
      {% set evergreens = evergreens + 1 %}
    {% endif %}
  {% endfor %}

  <section class="garden-stats" style="margin-bottom: var(--spacing-xl);">
    <h2 style="margin-bottom: var(--spacing-md); text-align: center;">Gardener's Dashboard</h2>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">🌱</div>
        <div class="stat-number">{{ seedlings }}</div>
        <div class="stat-label">Seeds Planted</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🌿</div>
        <div class="stat-number">{{ buddings }}</div>
        <div class="stat-label">Budding Thoughts</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🌳</div>
        <div class="stat-number">{{ evergreens }}</div>
        <div class="stat-label">Evergreen Essays</div>
      </div>
    </div>
  </section>
</div>
