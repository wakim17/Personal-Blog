---
layout: base.njk
title: All Topics
permalink: /topics/
---

<div class="homepage-container container">
  <section class="about-section section-intro">
    <h1 class="section-heading section-heading--sm">Topics Index</h1>
    <p class="section-description">Explore all the seeds and essays in the garden by their specific topics.</p>
  </section>

  <section class="topics-cloud" aria-label="Browse topics">
    {% for tag, posts in collections %}
      {% if tag != "all" and tag != "nav" and tag != "post" and tag != "posts" and tag != "tagList" and tag != "articles" %}
        <a href="/tags/{{ tag | slugify }}/" class="filter-btn">
          {{ tag }} <span class="topic-count">({{ posts.length }})</span>
        </a>
      {% endif %}
    {% endfor %}
  </section>
</div>
