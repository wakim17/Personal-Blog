---
layout: base.njk
title: All Topics
permalink: /topics/
---

<div class="homepage-container container">
  <section class="about-section" style="margin-bottom: var(--spacing-xl); padding-bottom: var(--spacing-xl); border-bottom: 1px solid var(--border-color);">
    <h1 style="margin-bottom: var(--spacing-md); font-size: 2rem;">Topics Index</h1>
    <p style="font-size: 1.15rem; max-width: 65ch; opacity: 0.9;">Explore all the seeds and essays in the garden by their specific topics.</p>
  </section>

  <section class="topics-cloud" style="display: flex; flex-wrap: wrap; gap: var(--spacing-md);">
    {% for tag, posts in collections %}
      {% if tag != "all" and tag != "nav" and tag != "post" and tag != "posts" and tag != "tagList" and tag != "articles" %}
        <a href="/tags/{{ tag | slugify }}/" class="filter-btn" style="text-decoration: none;">
          {{ tag }} <span style="opacity: 0.7; font-size: 0.8em; margin-left: 4px;">({{ posts.length }})</span>
        </a>
      {% endif %}
    {% endfor %}
  </section>
</div>
