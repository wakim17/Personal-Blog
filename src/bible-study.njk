---
layout: base.njk
title: Bible Study
permalink: /bible-study/
---

{% set studyCategories = ["All", "Jesus' Parables", "Gospel Meditations", "Old Testament Surveys", "Epistles & Doctrine", "Psalms & Wisdom", "General Study"] %}

<div class="homepage-container container">
  <header class="section-intro section-intro--no-border section-intro--centered">
    <h1 class="section-heading">Bible Study Notes & Meditations</h1>
    <p class="section-description section-description--centered">Expository notes, scripture meditations, and theological reflections exploring the eternal truth of God's Word.</p>
  </header>

  <div class="filter-sort-bar">
    <section class="category-filters" aria-label="Filter studies by category">
      <ul class="filter-list" id="category-filters" role="tablist" aria-label="Category filters">
        {% for cat in studyCategories %}
          <li role="presentation">
            <button class="filter-btn {% if loop.first %}active{% endif %}" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" data-category="{{ cat }}">{{ cat }}</button>
          </li>
        {% endfor %}
      </ul>
    </section>

    <div class="sort-controls">
      <label for="sort-order" class="sort-label">Sort:</label>
      <select id="sort-order" class="sort-select" aria-label="Sort Bible studies by date">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
      </select>
    </div>
  </div>

  <p id="filter-status" class="sr-only" aria-live="polite" role="status"></p>
  <section class="feed-grid" id="article-feed" aria-label="Bible study entries">
    {% for study in collections.bibleStudy %}
      <article class="card" data-category="{{ study.data.study_category | default('General Study') }}" data-date="{{ study.date.toISOString() }}">
        {% if study.data.thumbnail %}
          <div class="card-image">
            <img src="{{ study.data.thumbnail }}" alt="{{ study.data.title }}">
          </div>
        {% endif %}
        <div class="card-content">
          <div class="card-meta">
            <div class="badge-meta-row">
              {% if study.data.study_category %}
                <span class="badge primary-category">{{ study.data.study_category }}</span>
              {% endif %}
              {% if study.data.passage %}
                <span class="badge badge--passage">📖 {{ study.data.passage }}</span>
              {% endif %}
            </div>
            <time datetime="{{ study.date.toISOString() }}">{{ study.date | postDate }}</time>
          </div>
          <h2 class="card-title"><a href="{{ study.url }}">{{ study.data.title }}</a></h2>
          {% if study.data.excerpt %}
            <details class="card-excerpt-dropdown">
              <summary class="card-excerpt-summary">
                <span>Excerpt</span>
                <svg class="dropdown-chevron" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="card-excerpt-content">
                <p>{{ study.data.excerpt }}</p>
              </div>
            </details>
          {% endif %}
        </div>
      </article>
    {% else %}
      <p class="feed-empty">No Bible study entries published yet.</p>
    {% endfor %}
  </section>
</div>
