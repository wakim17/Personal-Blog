---
layout: base.njk
---

<article class="post-container">
  <header class="post-header">
    <div class="post-meta">
      <span class="badge primary-category">{{ primary_category }}</span>
      <time datetime="{{ date }}">{{ date | postDate }}</time>
      <button id="view-toggle" class="view-toggle-btn" aria-label="Toggle Wide Reading View" title="Toggle Wide Reading View">
        <svg class="view-toggle-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
        <span class="toggle-text">Wide View</span>
      </button>
    </div>
    <h1 class="post-title">{{ title }}</h1>
  </header>

  {% if thumbnail %}
    <figure class="post-thumbnail">
      <img src="{{ thumbnail }}" alt="Thumbnail for {{ title }}">
    </figure>
  {% endif %}

  <div class="post-body">
    {{ content | safe }}
  </div>

  {% if tags and tags.length > 0 %}
    <footer class="post-taxonomy">
      <strong>Filed under:</strong>
      {% for tag in tags %}
        <a href="/tags/{{ tag | slugify }}/" class="taxonomy-link">{{ tag }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </footer>
  {% endif %}
</article>

<section class="related-plantings container">
  <h2>Related Articles</h2>
  <div class="related-grid">
    {% set relatedCount = 0 %}
    {% for post in collections.articles %}
      {% if post.url != page.url %}
        {% set isRelated = false %}
        {% if post.data.primary_category == primary_category %}
          {% set isRelated = true %}
        {% endif %}
        
        {% if not isRelated and post.data.sub_tags and sub_tags %}
          {% for t1 in post.data.sub_tags %}
            {% for t2 in sub_tags %}
              {% if t1 == t2 %}
                {% set isRelated = true %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endif %}

        {% if isRelated and relatedCount < 3 %}
          <div class="card">
            {% if post.data.thumbnail %}
              <div class="card-image">
                <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}">
              </div>
            {% endif %}
            <div class="card-content">
              <div class="card-meta">
                <span class="badge primary-category">{{ post.data.primary_category }}</span>
                <time>{{ post.data.date | postDate }}</time>
              </div>
              <h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
              <p class="card-excerpt">{{ post.data.excerpt }}</p>
            </div>
          </div>
          {% set relatedCount = relatedCount + 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</section>
