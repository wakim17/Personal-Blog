---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
    - articles
  addAllPagesToCollections: true
layout: base.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /tags/{{ tag | slugify }}/
---

<div class="homepage-container container">
  <section class="about-section section-intro">
    <h1 class="section-heading section-heading--sm">Articles tagged with "{{ tag }}"</h1>
    <p class="section-description">
      <a href="/topics/">← Back to all topics</a>
    </p>
  </section>

  <section class="feed-grid" aria-label="Tagged articles">
    {% set taglist = collections[tag] %}
    {% for post in taglist | reverse %}
      <article class="card" data-category="{{ post.data.primary_category }}">
        {% if post.data.thumbnail %}
          <div class="card-image">
            <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}">
          </div>
        {% endif %}
        <div class="card-content">
          <div class="card-meta">
            <span class="badge primary-category">{{ post.data.primary_category }}</span>
            <time datetime="{{ post.date.toISOString() }}">{{ post.data.date | postDate }}</time>
          </div>
          <h2 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.excerpt %}
            <details class="card-excerpt-dropdown">
              <summary class="card-excerpt-summary">
                <span>Excerpt</span>
                <svg class="dropdown-chevron" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="card-excerpt-content">
                <p>{{ post.data.excerpt }}</p>
              </div>
            </details>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </section>
</div>
